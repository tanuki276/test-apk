<?xml version="1.0" ?>
<resources>
    <style name="CookSection" parent="Widget.Material3.CardView.Outlined">
        <item name="cardCornerRadius">20dp</item>
        <item name="cardElevation">0dp</item>
        <item name="cardBackgroundColor">#FFFFFF</item>
        <item name="strokeColor">#E1E5DE</item>
        <item name="strokeWidth">1dp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>
    <style name="CookTitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#20372F</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:layout_marginBottom">16dp</item>
    </style>
    <style name="CookLabel" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">#4D6259</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
    <style name="CookInput" parent="Widget.AppCompat.EditText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:padding">14dp</item>
        <item name="android:background">@drawable/rounded_edittext_bg</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">#20372F</item>
        <item name="android:textColorHint">#68796F</item>
    </style>
    <style name="CookPrimaryButton" parent="Widget.Material3.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">#24594B</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconTint">#FFFFFF</item>
        <item name="iconPadding">10dp</item>
    </style>
    <style name="CookOutlineButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textColor">#24594B</item>
        <item name="strokeColor">#CAD6CD</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconTint">#24594B</item>
        <item name="iconPadding">10dp</item>
    </style>
</resources>
