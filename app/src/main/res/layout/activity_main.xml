<?xml version="1.0" ?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F4F5EE" android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:paddingBottom="32dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginBottom="24dp">
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="CookAi" android:textSize="32sp" android:textStyle="bold" android:textColor="#20372F"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="あるもので、おいしく。" android:textSize="13sp" android:textColor="#66776D"/>
            </LinearLayout>
            <com.google.android.material.button.MaterialButton android:id="@+id/button_history" style="@style/CookOutlineButton" android:text="" app:icon="@drawable/ic_cook_history" android:layout_width="48dp" android:layout_height="52dp" android:minWidth="48dp" android:padding="12dp" app:iconPadding="0dp" android:layout_marginStart="8dp" android:contentDescription="履歴" android:tooltipText="履歴"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/button_settings" style="@style/CookOutlineButton" android:text="" app:icon="@drawable/ic_cook_settings" android:layout_width="48dp" android:layout_height="52dp" android:minWidth="48dp" android:padding="12dp" app:iconPadding="0dp" android:layout_marginStart="8dp" android:contentDescription="設定" android:tooltipText="設定"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="今日の一皿をつくる" android:textColor="#A66B42" android:textSize="14sp" android:lineSpacingExtra="4dp" android:textStyle="bold" android:layout_marginBottom="8dp"/>
        <com.google.android.material.card.MaterialCardView style="@style/CookSection">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView style="@style/CookTitle" android:text="使いたい食材" android:drawableStart="@drawable/ic_cook_leaf"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="冷蔵庫にある食材を教えてください。" android:textColor="#66776D" android:textSize="14sp" android:lineSpacingExtra="4dp"/>
                <TextView style="@style/CookLabel" android:text="食材"/>
                <EditText android:id="@+id/edit_text_ingredients" style="@style/CookInput" android:hint="例：鶏むね肉、玉ねぎ、卵" android:inputType="textMultiLine" android:gravity="top" android:minLines="3" android:maxLength="1500"/>
                <CheckBox android:id="@+id/checkbox_use_all_ingredients" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:text="入力した食材をすべて使う" android:textColor="#4D6259" android:buttonTint="#24594B"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/CookSection">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView style="@style/CookTitle" android:text="今回のレシピ" android:drawableStart="@drawable/ic_cook_dish"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="選ぶだけで、作りたい一皿に。" android:textColor="#66776D" android:textSize="14sp" android:lineSpacingExtra="4dp"/>
                <TextView style="@style/CookLabel" android:text="料理の種類" android:drawableStart="@drawable/ic_cook_dish" android:drawablePadding="10dp"/>
                <Spinner android:id="@+id/spinner_type" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:spinnerMode="dropdown" android:background="@drawable/rounded_spinner_bg" android:paddingStart="8dp" android:paddingEnd="28dp"/>
                <TextView style="@style/CookLabel" android:text="難易度" android:drawableStart="@drawable/ic_cook_levels" android:drawablePadding="10dp"/>
                <Spinner android:id="@+id/spinner_difficulty" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:spinnerMode="dropdown" android:background="@drawable/rounded_spinner_bg" android:paddingStart="8dp" android:paddingEnd="28dp"/>
                <TextView style="@style/CookLabel" android:text="ジャンル" android:drawableStart="@drawable/ic_cook_leaf" android:drawablePadding="10dp"/>
                <Spinner android:id="@+id/spinner_genre" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:spinnerMode="dropdown" android:background="@drawable/rounded_spinner_bg" android:paddingStart="8dp" android:paddingEnd="28dp"/>
                <TextView style="@style/CookLabel" android:text="調理時間" android:drawableStart="@drawable/ic_cook_clock" android:drawablePadding="10dp"/>
                <Spinner android:id="@+id/spinner_time" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:spinnerMode="dropdown" android:background="@drawable/rounded_spinner_bg" android:paddingStart="8dp" android:paddingEnd="28dp"/>
                <TextView style="@style/CookLabel" android:text="食事スタイル" android:drawableStart="@drawable/ic_cook_shield" android:drawablePadding="10dp"/>
                <Spinner android:id="@+id/spinner_diet" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp" android:spinnerMode="dropdown" android:background="@drawable/rounded_spinner_bg" android:paddingStart="8dp" android:paddingEnd="28dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.card.MaterialCardView style="@style/CookSection">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView style="@style/CookTitle" android:text="追加指示" android:drawableStart="@drawable/ic_cook_note"/>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="今回だけの希望はこちらにまとめて。" android:textColor="#66776D" android:textSize="14sp" android:lineSpacingExtra="4dp"/>
                <EditText android:id="@+id/edit_instructions" style="@style/CookInput" android:layout_marginTop="12dp" android:minLines="3" android:gravity="top" android:inputType="textMultiLine" android:maxLength="2000" android:hint="例：子ども向け、洗い物を少なく、辛くしない"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/button_generate_recipe" style="@style/CookPrimaryButton" android:text="レシピを生成する" app:icon="@drawable/ic_cook_spark"/>
        <TextView android:id="@+id/text_generation_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:textColor="#9C3030" android:accessibilityLiveRegion="polite" android:visibility="gone"/>
        <ProgressBar android:id="@+id/progress_bar_loading" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center_horizontal" android:layout_margin="16dp" android:indeterminateTint="#24594B" android:visibility="gone"/>
        <com.google.android.material.card.MaterialCardView style="@style/CookSection">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <TextView style="@style/CookTitle" android:text="できあがり" android:drawableStart="@drawable/ic_cook_pot"/>
                <TextView android:id="@+id/text_view_recipe_output" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="140dp" android:textIsSelectable="true" android:saveEnabled="false" android:text="@string/text_recipe_initial" android:textColor="#20372F" android:textSize="16sp" android:lineSpacingExtra="6dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/button_copy_recipe" style="@style/CookOutlineButton" android:text="コピー" app:icon="@drawable/ic_cook_copy"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/button_share_recipe" style="@style/CookOutlineButton" android:text="共有する" app:icon="@drawable/ic_cook_share"/>
    </LinearLayout>
</ScrollView>
