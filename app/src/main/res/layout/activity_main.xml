<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#F6F7FB" android:fillViewport="true" android:clipToPadding="false"
    tools:context=".MainActivity">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp" android:paddingTop="18dp" android:paddingBottom="32dp">
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="16dp" app:cardCornerRadius="22dp" app:cardElevation="2dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_alignParentStart="true" android:layout_centerVertical="true" android:layout_toStartOf="@id/button_history">
                        <TextView android:id="@+id/text_app_title" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/app_name" android:textColor="#172033" android:textSize="27sp" android:textStyle="bold" />
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="AIで、今日の食材からレシピを考える" android:textColor="#687386" android:textSize="13sp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_alignParentEnd="true">
                        <Button android:id="@+id/button_history" android:layout_width="wrap_content" android:layout_height="42dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="履歴" android:textSize="12sp" android:textStyle="bold" android:backgroundTint="#EEF2FF" android:textColor="#4354A8" />
                        <Button android:id="@+id/button_settings" android:layout_width="wrap_content" android:layout_height="42dp" android:layout_marginStart="6dp" android:minWidth="0dp" android:minHeight="0dp" android:paddingStart="10dp" android:paddingEnd="10dp" android:text="設定" android:textSize="12sp" android:textStyle="bold" android:backgroundTint="#FFF3E4" android:textColor="#A96518" />
                    </LinearLayout>
                </RelativeLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="材料を入力" android:textColor="#172033" android:textSize="19sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:layout_marginBottom="10dp" android:text="例：鶏むね肉、玉ねぎ、卵、キャベツ" android:textColor="#788398" android:textSize="13sp" />
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="12dp" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="#E2E6EF" app:strokeWidth="1dp">
            <EditText android:id="@+id/edit_text_ingredients" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="58dp" android:background="@android:color/transparent" android:hint="使いたい食材を入力" android:inputType="textCapSentences" android:paddingStart="16dp" android:paddingEnd="16dp" android:textColor="#172033" android:textColorHint="#9AA3B2" android:textSize="16sp" />
        </com.google.android.material.card.MaterialCardView>
        <CheckBox android:id="@+id/checkbox_use_all_ingredients" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="10dp" android:text="入力した食材をできるだけすべて使う" android:textColor="#3C4658" android:textSize="14sp" />
        <Button android:id="@+id/button_camera" android:layout_width="match_parent" android:layout_height="50dp" android:layout_marginBottom="18dp" android:backgroundTint="#E9F7EF" android:contentDescription="@string/content_description_camera" android:text="食材を写真から入力" android:textColor="#217A4B" android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="#E2E6EF" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="予算" android:textColor="#172033" android:textStyle="bold" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                    <EditText android:id="@+id/edit_text_min_price" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/rounded_edittext_bg" android:hint="下限" android:inputType="number" android:padding="12dp" />
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_marginEnd="8dp" android:text="〜" android:textColor="#687386" android:textSize="18sp" />
                    <EditText android:id="@+id/edit_text_max_price" android:layout_width="0dp" android:layout_height="48dp" android:layout_weight="1" android:background="@drawable/rounded_edittext_bg" android:hint="上限" android:inputType="number" android:padding="12dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="14dp" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="#E2E6EF" app:strokeWidth="1dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="レシピの条件" android:textColor="#172033" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="主食の分類" android:textColor="#687386" android:textSize="12sp" />
                <Spinner android:id="@+id/spinner_type" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/rounded_spinner_bg" android:entries="@array/type_options" android:padding="8dp" />
                <EditText android:id="@+id/edit_optional_type" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/rounded_edittext_bg" android:hint="自由指定（任意）" android:inputType="text" android:padding="12dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="難易度" android:textColor="#687386" android:textSize="12sp" />
                        <Spinner android:id="@+id/spinner_difficulty" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/rounded_spinner_bg" android:entries="@array/difficulty_options" android:padding="8dp" />
                        <EditText android:id="@+id/edit_optional_difficulty" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/rounded_edittext_bg" android:hint="自由指定" android:inputType="text" android:padding="10dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="ジャンル" android:textColor="#687386" android:textSize="12sp" />
                        <Spinner android:id="@+id/spinner_genre" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/rounded_spinner_bg" android:entries="@array/genre_options" android:padding="8dp" />
                        <EditText android:id="@+id/edit_optional_genre" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/rounded_edittext_bg" android:hint="自由指定" android:inputType="text" android:padding="10dp" />
                    </LinearLayout>
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginEnd="6dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="調理時間" android:textColor="#687386" android:textSize="12sp" />
                        <Spinner android:id="@+id/spinner_time" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/rounded_spinner_bg" android:entries="@array/time_options" android:padding="8dp" />
                        <EditText android:id="@+id/edit_optional_time" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/rounded_edittext_bg" android:hint="自由指定" android:inputType="text" android:padding="10dp" />
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="6dp" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="食事制限" android:textColor="#687386" android:textSize="12sp" />
                        <Spinner android:id="@+id/spinner_diet" android:layout_width="match_parent" android:layout_height="48dp" android:background="@drawable/rounded_spinner_bg" android:entries="@array/dietary_options" android:padding="8dp" />
                        <EditText android:id="@+id/edit_optional_diet" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="6dp" android:background="@drawable/rounded_edittext_bg" android:hint="自由指定" android:inputType="text" android:padding="10dp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="追加指示" android:textColor="#172033" android:textSize="16sp" android:textStyle="bold" />
        <EditText android:id="@+id/edit_instructions" android:layout_width="match_parent" android:layout_height="100dp" android:layout_marginTop="8dp" android:layout_marginBottom="14dp" android:background="@drawable/rounded_edittext_bg" android:gravity="top" android:hint="例：子ども向け、洗い物を少なく、辛くしない" android:inputType="textMultiLine" android:maxLines="5" android:padding="14dp" />
        <Button android:id="@+id/button_generate_recipe" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginBottom="18dp" android:backgroundTint="#4F63D9" android:text="レシピを生成する" android:textColor="@android:color/white" android:textSize="17sp" android:textStyle="bold" />
        <ProgressBar android:id="@+id/progress_bar_loading" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginBottom="14dp" android:visibility="gone" />
        <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="生成されたレシピ" android:textColor="#172033" android:textSize="19sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_alignParentEnd="true" android:text="保存・共有できます" android:textColor="#788398" android:textSize="11sp" />
        </RelativeLayout>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" app:cardCornerRadius="20dp" app:cardElevation="1dp" app:strokeColor="#E2E6EF" app:strokeWidth="1dp">
            <TextView android:id="@+id/text_view_recipe_output" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="180dp" android:padding="18dp" android:text="@string/text_recipe_initial" android:textColor="#273044" android:textSize="15sp" android:lineSpacingExtra="3dp" />
        </com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal">
            <Button android:id="@+id/button_copy_recipe" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:text="レシピをコピー" android:textStyle="bold" android:backgroundTint="#EEF2FF" android:textColor="#4354A8" />
            <Button android:id="@+id/button_share_recipe" android:layout_width="0dp" android:layout_height="50dp" android:layout_weight="1" android:layout_marginStart="6dp" android:text="レシピを共有" android:textStyle="bold" android:backgroundTint="#EAF7F0" android:textColor="#217A4B" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
